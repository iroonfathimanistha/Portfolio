GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# ADMIN AUTHENTICATION (For Vercel / Production Serverless Deployments)
AUTH_SECRET=
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# PERSISTENT DATABASE (For Vercel Production Deployments)
# Vercel KV / Upstash Redis
KV_REST_API_URL=
KV_REST_API_TOKEN=


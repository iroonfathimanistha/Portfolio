{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/admin/login",
      "destination": "/admin/login/index.html"
    },
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin/index.html"
    },
    {
      "source": "/projects/:slug*",
      "destination": "/index.html"
    },
    {
      "source": "/resume",
      "destination": "/index.html"
    }
  ]
}
